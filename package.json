{
  "name": "better-india",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "parcel serve index.html --dist-dir .parcel-dev",
    "dev:backend": "cd backend && npm run dev",
    "start": "parcel serve index.html --dist-dir .parcel-dev",
    "build": "parcel build index.html --dist-dir dist",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.13.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "parcel": "^2.16.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
